{
  "name": "audio2txt",
  "productName": "Audio2txt",
  "private": true,
  "version": "0.1.4",
  "main": "electron/main.cjs",
  "description": "A local desktop transcription studio for turning audio into editable timestamped text.",
  "author": "SHIM1999",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
    "electron": "concurrently -k \"npm run client -- --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env AUDIO2TXT_ELECTRON_DEV=1 electron .\"",
    "build": "tsc -b && vite build",
    "electron:stage": "powershell -ExecutionPolicy Bypass -File scripts/stage-electron-windows.ps1",
    "build:electron": "powershell -ExecutionPolicy Bypass -File scripts/build-electron-windows.ps1",
    "lint": "oxlint",
    "preview": "vite preview",
    "package:portable": "powershell -ExecutionPolicy Bypass -File scripts/package-portable-windows.ps1"
  },
  "build": {
    "appId": "com.shim1999.audio2txt",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "directories": {
      "output": "desktop-release"
    },
    "files": [
      "**/*",
      "!src/**/*",
      "!public/**/*",
      "!uploads/**/*",
      "!packages/**/*",
      "!desktop-release/**/*",
      "!dist-python/**/*",
      "!.release/**/*",
      "!*.bat",
      "!*.zip",
      "!*.log",
      "!tsconfig*.json",
      "!vite.config.ts",
      "!.oxlintrc.json",
      "server/portable-server.cjs",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      },
      {
        "from": "dist-python/transcribe",
        "to": "scripts/transcribe-runtime"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "package.json",
        "to": "package.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Audio2txt"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "SHIM1999",
        "repo": "Audio2txt"
      }
    ]
  },
  "dependencies": {
    "concurrently": "^10.0.3",
    "cors": "^2.8.6",
    "docx": "^9.7.1",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.25.0",
    "multer": "^2.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.4",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-winstaller": "^5.4.4",
    "oxlint": "^1.71.0",
    "pkg": "^5.8.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "wait-on": "^9.1.0"
  }
}
