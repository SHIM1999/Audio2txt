{
    "name":  "audio2txt",
    "productName":  "Audio2txt",
    "version":  "0.1.5",
    "main":  "electron/main.cjs",
    "description":  "A local desktop transcription studio for turning audio into editable timestamped text.",
    "author":  "SHIM1999",
    "dependencies":  {
                         "concurrently":  "^10.0.3",
                         "cors":  "^2.8.6",
                         "docx":  "^9.7.1",
                         "electron-squirrel-startup":  "^1.0.1",
                         "express":  "^5.2.1",
                         "lottie-web":  "^5.13.0",
                         "lucide-react":  "^1.25.0",
                         "multer":  "^2.2.0",
                         "react":  "^19.2.7",
                         "react-dom":  "^19.2.7"
                     },
    "build":  {
                  "appId":  "com.shim1999.audio2txt",
                  "electronVersion":  "43.2.0",
                  "extraMetadata":  {
                                        "name":  "audio2txt",
                                        "productName":  "Audio2txt",
                                        "version":  "0.1.5",
                                        "main":  "electron/main.cjs"
                                    },
                  "artifactName":  "${productName}-${version}-${os}-${arch}.${ext}",
                  "asar":  true,
                  "disableDefaultIgnoredFiles":  true,
                  "directories":  {
                                      "output":  "D:\\MyPortfolio\\07_Web_Basic\\Audio2txt\\desktop-release"
                                  },
                  "extraResources":  [
                                         {
                                             "from":  "dist",
                                             "to":  "dist"
                                         },
                                         {
                                             "from":  "build",
                                             "to":  "build"
                                         },
                                         {
                                             "from":  "scripts/transcribe-runtime",
                                             "to":  "scripts/transcribe-runtime"
                                         },
                                         {
                                             "from":  "requirements.txt",
                                             "to":  "requirements.txt"
                                         },
                                         {
                                             "from":  "README.md",
                                             "to":  "README.md"
                                         },
                                         {
                                             "from":  "package.json",
                                             "to":  "package.json"
                                         }
                                     ],
                  "win":  {
                              "target":  [
                                             "nsis"
                                         ]
                          },
                  "nsis":  {
                               "oneClick":  false,
                               "allowToChangeInstallationDirectory":  true,
                               "createDesktopShortcut":  true,
                               "createStartMenuShortcut":  true,
                               "shortcutName":  "Audio2txt"
                           },
                  "publish":  [
                                  {
                                      "provider":  "github",
                                      "owner":  "SHIM1999",
                                      "repo":  "Audio2txt"
                                  }
                              ]
              }
}
